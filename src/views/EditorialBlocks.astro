---
import type { EditorialBlock } from '@/domain';

interface Props {
  blocks: EditorialBlock[];
}

const { blocks } = Astro.props;
---

<div class="editorial-body">
  {blocks.map((block) => {
    if (block.type === 'heading') {
      return block.level === 2 ? <h2>{block.text}</h2> : <h3>{block.text}</h3>;
    }

    if (block.type === 'list') {
      return block.style === 'ordered'
        ? <ol>{block.items.map((item) => <li>{item}</li>)}</ol>
        : <ul>{block.items.map((item) => <li>{item}</li>)}</ul>;
    }

    if (block.type === 'quote') {
      return (
        <blockquote>
          <p>{block.text}</p>
          {block.attribution && <cite>{block.attribution}</cite>}
        </blockquote>
      );
    }

    return <p>{block.text}</p>;
  })}
</div>

<style>
  .editorial-body {
    max-width: 46rem;
    margin-inline: auto;
    color: var(--color-ink-soft);
    font-size: var(--step-0);
    line-height: 1.8;
  }

  .editorial-body > :global(*) + :global(*) {
    margin-top: 1.35em;
  }

  .editorial-body :global(h2) {
    margin-top: 2.2em;
    color: var(--color-ink);
    font-size: var(--step-3);
  }

  .editorial-body :global(h3) {
    margin-top: 1.9em;
    color: var(--color-ink);
    font-size: var(--step-2);
  }

  .editorial-body :global(ul),
  .editorial-body :global(ol) {
    display: grid;
    gap: 0.65rem;
    padding-inline-start: 1.35rem;
  }

  .editorial-body :global(li)::marker {
    color: var(--color-accent);
    font-weight: 800;
  }

  .editorial-body :global(blockquote) {
    margin-block: var(--space-7);
    padding: var(--space-5);
    border-inline-start: 0.25rem solid var(--color-accent);
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.35;
  }

  .editorial-body :global(cite) {
    display: block;
    margin-top: var(--space-3);
    color: var(--color-ink-faint);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-style: normal;
  }
</style>

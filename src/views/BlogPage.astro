---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTA from '@/components/CTA.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getContent } from '@/data';
import type { Locale } from '@/domain';
import { blogPostPath, routePath, type BlogPostId } from '@/i18n';

interface Props {
  language: Locale;
}

const { language } = Astro.props;
const content = await getContent(language);
const page = content.pages.blog;
const posts = [...content.blogPosts].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
const allTopics = [...new Set(posts.flatMap((post) => post.topics))];
const dateFormatter = new Intl.DateTimeFormat(language === 'es' ? 'es-CL' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const copy = language === 'es'
  ? {
      latest: 'Última nota',
      read: 'Leer nota',
      editorial: 'Línea editorial',
      editorialTitle: 'Escribir cuando una decisión técnica merece contexto.',
      editorialText:
        'Este espacio reúne aprendizajes sobre arquitectura, delivery, sistemas operacionales y liderazgo técnico. Cada nota busca dejar una idea aplicable, no mantener una frecuencia artificial.',
      themes: 'Temas de trabajo',
      rss: 'Seguir por RSS',
      ctaEyebrow: 'Continuar la conversación',
      ctaTitle: '¿Una de estas ideas conecta con un problema real?',
      ctaDescription:
        'Conversemos sobre el contexto técnico u operacional detrás del sistema que estás construyendo.',
      ctaPrimary: 'Escribir a Yerko',
      ctaSecondary: 'Ver casos de estudio',
    }
  : {
      latest: 'Latest note',
      read: 'Read note',
      editorial: 'Editorial approach',
      editorialTitle: 'Write when a technical decision deserves context.',
      editorialText:
        'This space collects lessons about architecture, delivery, operational systems, and technical leadership. Each note aims to leave one applicable idea rather than serve an artificial publishing schedule.',
      themes: 'Working topics',
      rss: 'Follow via RSS',
      ctaEyebrow: 'Continue the conversation',
      ctaTitle: 'Does one of these ideas connect with a real problem?',
      ctaDescription:
        'Let’s discuss the technical or operational context behind the system you are building.',
      ctaPrimary: 'Email Yerko',
      ctaSecondary: 'View case studies',
    };
---

<BaseLayout title={page.title} description={page.description} language={language} ogImage="/og.png">
  <section class="page-hero shell">
    <SectionHeading
      eyebrow={page.eyebrow}
      title={page.title}
      description={page.description}
      as="h1"
      size="hero"
    >
      <a slot="actions" class="button button--secondary" href={routePath('rss', language)}>
        {copy.rss}
      </a>
    </SectionHeading>
  </section>

  <section class="posts shell" aria-label={copy.latest}>
    {posts.map((post, index) => (
      <article class:list={['post-card', { 'post-card--featured': index === 0 }]}>
        <div class="post-meta">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <time datetime={post.publishedAt}>{dateFormatter.format(new Date(`${post.publishedAt}T00:00:00Z`))}</time>
          <span>{post.readingMinutes} {content.labels.minuteRead}</span>
        </div>
        <div>
          <p class="eyebrow">{index === 0 ? copy.latest : page.eyebrow}</p>
          <h2><a href={blogPostPath(post.id as BlogPostId, language)}>{post.title}</a></h2>
          <p class="excerpt">{post.excerpt}</p>
          <ul class="tag-list" aria-label={content.labels.topics}>
            {post.topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
        <a class="text-link" href={blogPostPath(post.id as BlogPostId, language)}>
          {copy.read}
        </a>
      </article>
    ))}
  </section>

  <section class="editorial section section--ruled surface">
    <div class="shell editorial-grid">
      <p class="eyebrow">{copy.editorial}</p>
      <div>
        <h2>{copy.editorialTitle}</h2>
        <p>{copy.editorialText}</p>
        <div class="topic-block">
          <h3>{copy.themes}</h3>
          <ul class="tag-list large-tags">
            {allTopics.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell">
    <CTA
      eyebrow={copy.ctaEyebrow}
      title={copy.ctaTitle}
      description={copy.ctaDescription}
      primary={{
        label: copy.ctaPrimary,
        href: `mailto:${content.settings.contactEmail}?subject=${encodeURIComponent(language === 'es' ? 'Conversación técnica desde yerkoacuna.dev' : 'Technical conversation from yerkoacuna.dev')}`,
      }}
      secondary={{ label: copy.ctaSecondary, href: routePath('work', language) }}
      tone="light"
    />
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-9) var(--space-8);
  }

  .posts {
    border-top: 1px solid var(--color-line-strong);
  }

  .post-card {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1.35fr) auto;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-line);
  }

  .post-meta {
    display: grid;
    gap: var(--space-2);
    color: var(--color-ink-faint);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-meta span:first-child {
    color: var(--color-accent);
  }

  .post-card h2 {
    max-width: 19ch;
    margin-top: var(--space-3);
    font-size: var(--step-3);
  }

  .post-card h2 a {
    text-decoration: none;
  }

  .post-card h2 a:hover {
    color: var(--color-accent-strong);
  }

  .excerpt {
    max-width: 58ch;
    margin-top: var(--space-4);
    color: var(--color-ink-soft);
  }

  .post-card .tag-list {
    margin-top: var(--space-5);
  }

  .post-card > .text-link {
    align-self: end;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: minmax(10rem, 0.42fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 8vw, 8rem);
  }

  .editorial h2 {
    max-width: 16ch;
    font-size: var(--step-3);
  }

  .editorial h2 + p {
    max-width: var(--measure);
    margin-top: var(--space-5);
    color: var(--color-ink-soft);
  }

  .topic-block {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .topic-block h3 {
    font-size: var(--step--1);
    font-weight: 780;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .large-tags {
    margin-top: var(--space-4);
  }

  @media (max-width: 50rem) {
    .post-card,
    .editorial-grid {
      grid-template-columns: 1fr;
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
    }
  }
</style>

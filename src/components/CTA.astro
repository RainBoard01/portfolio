---
export interface CTAAction {
  label: string;
  href: string;
  download?: boolean;
  external?: boolean;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primary: CTAAction;
  secondary?: CTAAction;
  tone?: 'ink' | 'mineral' | 'light';
  id?: string;
}

const {
  eyebrow,
  title,
  description,
  primary,
  secondary,
  tone = 'ink',
  id = 'contact-cta-title',
} = Astro.props;
---

<aside class:list={['cta', `cta--${tone}`]} aria-labelledby={id}>
  <div class="cta-copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
    <p>{description}</p>
  </div>
  <div class="cta-actions">
    <a
      class="cta-button cta-button--primary"
      href={primary.href}
      download={primary.download}
      target={primary.external ? '_blank' : undefined}
      rel={primary.external ? 'noreferrer' : undefined}
    >
      {primary.label}
    </a>
    {secondary && (
      <a
        class="cta-button cta-button--secondary"
        href={secondary.href}
        download={secondary.download}
        target={secondary.external ? '_blank' : undefined}
        rel={secondary.external ? 'noreferrer' : undefined}
      >
        {secondary.label}
      </a>
    )}
  </div>
</aside>

<style>
  .cta {
    display: grid;
    overflow: hidden;
    min-height: 27rem;
    grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.55fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding: clamp(2rem, 6vw, 6rem);
    border-radius: var(--radius-lg);
  }

  .cta--ink {
    background: var(--color-ink);
    color: #f4f0e7;
  }

  .cta--mineral {
    background: var(--color-accent-strong);
    color: var(--color-on-accent);
  }

  .cta--light {
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .cta .eyebrow {
    color: currentColor;
    opacity: 0.68;
  }

  h2 {
    max-width: 13ch;
    margin-top: var(--space-4);
    color: currentColor;
    font-size: var(--step-4);
  }

  .cta-copy > p:last-child {
    max-width: 58ch;
    margin-top: var(--space-5);
    color: currentColor;
    font-size: var(--step-1);
    opacity: 0.74;
  }

  .cta-actions {
    display: grid;
    gap: var(--space-3);
  }

  .cta-button {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1.1rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    font-weight: 760;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .cta-button::after {
    content: '\2192';
  }

  .cta-button:hover {
    transform: translateY(-2px);
  }

  .cta--ink .cta-button--primary,
  .cta--mineral .cta-button--primary {
    border-color: #f4f0e7;
    background: #f4f0e7;
    color: var(--color-ink);
  }

  .cta--ink .cta-button--primary:hover,
  .cta--mineral .cta-button--primary:hover {
    background: #fff;
  }

  .cta--light .cta-button--primary {
    border-color: var(--color-accent-strong);
    background: var(--color-accent-strong);
    color: var(--color-on-accent);
  }

  .cta-button--secondary {
    background: transparent;
    color: currentColor;
  }

  .cta-button--secondary:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  @media (max-width: 48rem) {
    .cta {
      min-height: auto;
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>

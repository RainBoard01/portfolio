---
import type { Locale, Service } from '@/domain';
import { routePath } from '@/i18n/routes';

interface Props {
  service: Service;
  language?: Locale;
  index?: number;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  service,
  language = 'en',
  index,
  ctaHref = routePath('contact', language),
  ctaLabel = language === 'es' ? 'Conversar sobre este servicio' : 'Discuss this service',
} = Astro.props;

const copy = language === 'es'
  ? { suitable: 'Ideal para', includes: 'Entregables habituales', technologies: 'Tecnologías' }
  : { suitable: 'Best suited for', includes: 'Typical deliverables', technologies: 'Technologies' };
const titleId = `service-${service.id}-title`;
---

<article class="service-card" aria-labelledby={titleId}>
  <header>
    {typeof index === 'number' && (
      <p class="service-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
    )}
    <h3 id={titleId}>{service.title}</h3>
    <p class="service-summary">{service.summary}</p>
  </header>

  <div class="service-details">
    <div>
      <h4>{copy.suitable}</h4>
      <ul>
        {service.suitableFor.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <h4>{copy.includes}</h4>
      <ul>
        {service.deliverables.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>

  <footer>
    {service.technologies.length > 0 && (
      <ul class="tag-list" aria-label={copy.technologies}>
        {service.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    )}
    <a class="text-link" href={ctaHref}>{ctaLabel}</a>
  </footer>
</article>

<style>
  .service-card {
    display: grid;
    min-height: 100%;
    padding: clamp(1.4rem, 3vw, 2.5rem);
    border-top: 1px solid var(--color-line-strong);
    background: color-mix(in srgb, var(--color-surface) 48%, transparent);
    grid-template-rows: auto 1fr auto;
  }

  .service-index {
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 780;
    letter-spacing: 0.08em;
  }

  h3 {
    max-width: 22ch;
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .service-summary {
    max-width: 56ch;
    margin-top: var(--space-4);
    color: var(--color-ink-soft);
  }

  .service-details {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    padding-block: var(--space-6);
  }

  .service-details > div {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  h4 {
    font-size: 0.68rem;
    font-weight: 780;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-details ul {
    display: grid;
    gap: 0.45rem;
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .service-details li {
    position: relative;
    padding-inline-start: 1rem;
    color: var(--color-ink-soft);
    font-size: var(--step--1);
  }

  .service-details li::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
  }

  footer {
    display: grid;
    gap: var(--space-5);
    align-items: end;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }
</style>

# Canonical URL used for sitemap, RSS and social metadata.
PUBLIC_SITE_URL=https://yerkoacuna.dev

# Public contact destinations. These are embedded in the generated HTML.
PUBLIC_CONTACT_EMAIL=contact@yerkoacuna.dev
PUBLIC_GITHUB_URL=https://github.com/RainBoard01
# PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile

# Optional form endpoint (Formspree, Basin, a self-hosted endpoint, etc.).
# When absent, the site uses email links and does not render a broken form.
# PUBLIC_CONTACT_FORM_ENDPOINT=https://example.com/forms/contact

# Content provider. Directus is queried only while the site is built.
CONTENT_SOURCE=local
CONTENT_FALLBACK=fail
# DIRECTUS_URL=https://cms.example.com
# DIRECTUS_TOKEN=replace-with-a-read-only-build-token

# Optional build revision displayed only in generated metadata.
# CAPROVER_GIT_COMMIT_SHA=local
